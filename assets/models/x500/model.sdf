  <link name="terrain_lidar_link"><pose relative_to="base_link">0.35 0 -0.19 0 0 0</pose><inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><sensor name="terrain_lidar" type="gpu_lidar"><update_rate>5</update_rate><always_on>true</always_on><visualize>false</visualize><lidar><scan><horizontal><samples>361</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal><vertical><samples>95</samples><resolution>1</resolution><min_angle>-1.53588974175501</min_angle><max_angle>0.209439510239320</max_angle></vertical></scan><range><min>0.3</min><max>100</max><resolution>0.02</resolution></range></lidar></sensor></link><joint name="terrain_lidar_fixed" type="fixed"><parent>base_link</parent><child>terrain_lidar_link</child></joint></model>
